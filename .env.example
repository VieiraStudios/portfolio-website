# Copy this file to .env and fill in real values. Never commit .env.

# Long random string. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional: email new contact-form messages to yourself.
# Leave blank to only save messages to instance/messages.jsonl.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
